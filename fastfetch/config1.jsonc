// this is the default config of fastfetch, will run in case config2.jsonc doesnt
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto"
  },
  "display": {
    "separator": " | ",
    "color": {
      "keys": "green",
      "title": "bright_green",
      "separator": "green"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "publicip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
