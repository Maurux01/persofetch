{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // El randomizer (randomizer.sh) sobreescribe type/source por CLI:
    //   --logo-type kitty --logo ~/shell-workflow/utils/icons/*.png
    //   --logo-type kitty --logo ~/shell-workflow/utils/gifs/*.gif (animado en kitty)
    //   --logo-type file  --logo ~/shell-workflow/utils/ASCII/*.txt
    //   videos -> thumbnail png vía ffmpeg, mostrado como kitty
    // Este bloque es solo el fallback cuando se llama `command fastfetch` directo.
    "type": "kitty",
    "source": "~/shell-workflow/utils/icons/skull.png",
    "color": {
      "1": "green",
      "2": "bright_green"
    },
    "padding": {
      "top": 1,
      "left": 2
    },
    "width": 32,
    "height": 18
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "green",
      "title": "bright_green",
      "separator": "green"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "fastfetch - {version}",
      "color": {
        "title": "bright_green"
      }
    },
    {
      "type": "os",
      "key": "   Linux",
      "format": "{name} {version} ({arch})"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{name} {version}"
    },
    {
      "type": "locale",
      "key": "   Locale"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Hardware                                    │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "chassis",
      "key": "   Chassis"
    },
    {
      "type": "memory",
      "key": "   RAM",
      "format": "{used} / {total} ({percentage}%)"
    },
    {
      "type": "swap",
      "key": "   SWAP",
      "format": "{used} / {total} ({percentage}%)"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{name} ({cores}) @ {maxFrequency} GHz"
    },
    {
      "type": "gpu",
      "key": "   GPU",
      "format": "{name} ({size} GiB) [{type}]"
    },
    {
      "type": "disk",
      "key": "   Disk",
      "format": "{used} / {total} ({percentage}%) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Desktop                                     │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "desktop",
      "key": " 﩯  Desktop"
    },
    {
      "type": "wm",
      "key": "   Session"
    },
    {
      "type": "display",
      "key": "   Display",
      "format": "{resolution} @ {refreshRate}Hz"
    },
    {
      "type": "opengl",
      "key": "   G-Driver"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
      "outputColor": "green"
    },
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [0, 7]
      }
    }
  ]
}
