{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Config ÚNICA de shell-workflow (antes config.jsonc/config1/config2).
    // Protocolo kitty de imágenes: type "kitty" manda el gif por el graphics
    // protocol de kitty (único tipo cuya animación decodifica y compone el
    // propio fastfetch). Requiere estar DENTRO de kitty; fuera de kitty cae
    // al logo builtin (para eso está el wrapper ff/fetch -> randomizer.sh,
    // que elige kitty|chafa|file según el terminal).
    // - source: granja logos/utils/* (symlinks a utils/icons/*.png y
    //   utils/gifs/*.gif, creada por install.sh paso 3.d). Un solo glob no
    //   combina dos carpetas/extensiones, por eso existe la granja.
    //   fastfetch elige un archivo al azar en cada llamada directa
    //   (`command fastfetch`). El wrapper randomizer lo sobreescribe
    //   por CLI con png/gif/txt/colorscripts según sorteo y terminal.
    // - Animación (gif): existe como clave `animationFrame` solo desde
    //   fastfetch 2.69; el de Debian trixie (2.40.4) la rechaza con
    //   "unknown logo key" y por eso NO va en este archivo. El randomizer
    //   la pasa por CLI (--logo-animation-frame 0 = reproducir) solo si
    //   detecta fastfetch >= 2.69. En versiones viejas el gif sale fijo
    //   (primer frame), que sí funciona.
    // - width/height SIEMPRE fijados: sin esto el gif sale a tamaño natural
    //   y hace scroll/corte (wiki Troubleshooting #2 y #5).
    //   Medida única del workflow: 40 cols x 20 líneas (panel ~= 21 líneas).
    //   Debe coincidir con LOGO_W/LOGO_H de randomizer.sh.
    // Si el gif no sale y ves el logo builtin: `fastfetch --show-errors`
    // (en Linux el tipo kitty necesita fastfetch compilado con imagemagick).
    "type": "kitty",
    "source": "~/.config/fastfetch/utils/*",
    "width": 40,
    "height": 20,
    "color": {
      "1": "green",
      "2": "bright_green"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "green",
      "title": "bright_green",
      "separator": "green"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "title": "bright_green"
      }
    },
    {
      "type": "os",
      "key": "   Linux",
      "format": "{name} {version} ({arch})"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{name} {version}"
    },
    {
      "type": "locale",
      "key": "   Locale"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Hardware                                    │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "chassis",
      "key": "   Chassis"
    },
    {
      "type": "memory",
      "key": "   RAM",
      "format": "{used} / {total} ({percentage}%)"
    },
    {
      "type": "swap",
      "key": "   SWAP",
      "format": "{used} / {total} ({percentage}%)"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{name} ({cores}) @ {maxFrequency} GHz"
    },
    {
      "type": "gpu",
      "key": "   GPU",
      "format": "{name} ({size} GiB) [{type}]"
    },
    {
      "type": "disk",
      "key": "   Disk",
      "format": "{used} / {total} ({percentage}%) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Desktop                                     │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "desktop",
      "key": "   Desktop"
    },
    {
      "type": "wm",
      "key": "   Session"
    },
    {
      "type": "display",
      "key": "   Display",
      "format": "{resolution} @ {refreshRate}Hz"
    },
    {
      "type": "opengl",
      "key": "   G-Driver"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
      "outputColor": "green"
    },
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [0, 7]
      }
    }
  ]
}
