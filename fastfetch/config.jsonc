{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // El randomizer (randomizer.sh) sobreescribe type/source por CLI:
    //   kitty con gráficos -> --logo-type kitty --logo utils/icons/*.png|gifs/*.gif
    //   terminal normal + chafa -> --logo-type chafa --logo <png|gif|jpg>
    //   sin gráficos -> --logo-type file --logo utils/ASCII/*.txt
    // Este bloque es solo el fallback para `command fastfetch` directo:
    // ASCII que existe siempre tras install.sh (utils/ -> ~/.config/fastfetch/utils).
    "type": "file",
    "source": "~/.config/fastfetch/utils/ASCII/debian.txt",
    "color": {
      "1": "green",
      "2": "bright_green"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "green",
      "title": "bright_green",
      "separator": "green"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "title": "bright_green"
      }
    },
    {
      "type": "os",
      "key": "  OS",
      "format": "{name} {version} ({arch})"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "format": "{sysname} {release} {version}"
    },
    {
      "type": "locale",
      "key": "  Locale"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Hardware                                    │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "chassis",
      "key": "  Chassis"
    },
    {
      "type": "memory",
      "key": "  RAM",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "  Swap",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{name} ({cores-logical}) @ {freq-base}"
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "format": "{name} ({dedicated-total}) [{type}]"
    },
    {
      "type": "disk",
      "key": "  Disk",
      "format": "[{mountpoint}] {size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "│  Desktop                                     │",
      "outputColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "desktop",
      "key": "  Desktop"
    },
    {
      "type": "wm",
      "key": "  Session"
    },
    {
      "type": "display",
      "key": "  Display"
    },
    {
      "type": "opengl",
      "key": "  GL-Driver"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
      "outputColor": "green"
    },
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [0, 7]
      }
    }
  ]
}
