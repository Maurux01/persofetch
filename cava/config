# shell-workflow :: cava/config
# Tema hacker verde. Se instala en ~/.config/cava/config vía install.sh.

[general]
framerate = 60
autosens = 1
sensitivity = 100
bars_number = 32
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[input]
method = pulse
source = auto

[output]
method = ncurses

[color]
background = '#000000'
foreground = '#00ff00'
gradient = 1
gradient_count = 4
gradient_color_1 = '#005f00'
gradient_color_2 = '#00af00'
gradient_color_3 = '#00ff00'
gradient_color_4 = '#afffaf'

[smoothing]
noise_reduction = 77
monstercat = 0
waves = 0
